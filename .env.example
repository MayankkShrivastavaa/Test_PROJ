# Port the backend listens on during local development.
PORT=5000

# Secret used to sign and verify JWTs (POST /api/token, GET /api/protected).
# Generate a real random value for actual use, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# This MUST also be set as an environment variable on Vercel - it is not
# committed here as a real value, only as a placeholder name.
JWT_SECRET=replace-this-with-a-long-random-string
